# syntax=docker/dockerfile:1
ARG CUDA_RUNTIME_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY vod-review/frontend/package.json vod-review/frontend/package-lock.json ./
RUN npm ci
COPY vod-review/frontend/ ./
# Production API, video playback and the SPA share the container's origin.
ENV VITE_API_BASE=""
RUN npm run build

FROM ghcr.io/astral-sh/uv:0.10.12@sha256:72ab0aeb448090480ccabb99fb5f52b0dc3c71923bffb5e2e26517a1c27b7fec AS uv
FROM ${CUDA_RUNTIME_IMAGE} AS native
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_PYTHON_PREFERENCE=only-managed UV_LINK_MODE=copy \
    PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    HOME=/home/app XDG_CACHE_HOME=/home/app/.cache HF_HOME=/home/app/.cache/huggingface \
    PADDLE_PDX_CACHE_HOME=/home/app/.paddlex YOLO_CONFIG_DIR=/home/app/.config/Ultralytics \
    PYTHONPATH=/opt/tft-apps:/opt/tft-apps/vod-review
# Torch/ONNX in the lock use CUDA 13 wheels; CTranslate2 still needs CUDA 12.
# Keep both library families available without replacing locked packages.
ENV LD_LIBRARY_PATH=/opt/venv/lib/python3.13/site-packages/nvidia/cu13/lib:/opt/venv/lib/python3.13/site-packages/nvidia/cudnn/lib:/usr/local/cuda/lib64:/usr/local/nvidia/lib:/usr/local/nvidia/lib64
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates ffmpeg libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/app && chmod 1777 /home/app
RUN uv python install 3.13
WORKDIR /opt/tft-apps/vod-review
FROM native AS dependencies
COPY vod-review/pyproject.toml vod-review/uv.lock ./
RUN uv sync --locked --python 3.13 --extra transcription --no-install-project --no-dev
FROM native
# Copy installed dependencies without shipping the package download cache.
COPY --from=dependencies /opt/venv /opt/venv
COPY vod-review/ ./
COPY docker/backend.py /opt/tft-apps/docker/backend.py
COPY desktop/utils.py /opt/tft-apps/desktop/utils.py
COPY --from=frontend /build/dist ./frontend/dist
# Replay schedules validate IANA zones through Python's system zoneinfo data.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*
EXPOSE 8000
ENV XDG_STATE_HOME=/home/app/state
ENTRYPOINT []
CMD ["python", "/opt/tft-apps/docker/backend.py", "--service", "vod"]
