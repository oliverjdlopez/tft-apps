# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim
ARG FRONTEND_DIR=tft-chat/app/frontend
WORKDIR /opt/tft-apps/${FRONTEND_DIR}
COPY ${FRONTEND_DIR}/package.json ${FRONTEND_DIR}/package-lock.json ./
RUN npm ci
COPY ${FRONTEND_DIR}/ ./
ENV HOME=/home/app VITE_API_BASE=""
# Compose runs with the host uid/gid; only Vite's generated caches need writes.
RUN mkdir -p /home/app node_modules/.vite node_modules/.vite-temp \
    && chmod 1777 /home/app node_modules/.vite node_modules/.vite-temp
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]
