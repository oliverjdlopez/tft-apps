# syntax=docker/dockerfile:1
ARG CUDA_RUNTIME_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY tft-chat/app/frontend/package.json tft-chat/app/frontend/package-lock.json ./
RUN npm ci
COPY tft-chat/app/frontend/ ./
RUN npm run build

FROM ghcr.io/astral-sh/uv:0.10.12@sha256:72ab0aeb448090480ccabb99fb5f52b0dc3c71923bffb5e2e26517a1c27b7fec AS uv
FROM ${CUDA_RUNTIME_IMAGE} AS native
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_PYTHON_PREFERENCE=only-managed UV_LINK_MODE=copy \
    PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    HOME=/home/app XDG_CACHE_HOME=/home/app/.cache HF_HOME=/home/app/.cache/huggingface \
    PYTHONPATH=/opt/tft-apps:/opt/tft-apps/tft-chat:/opt/tft-apps/tft-chat/app/backend:/opt/tft-apps/tft-chat/app/backend/src
# The CUDA 12 runtime supplies faster-whisper's cuBLAS/cuDNN requirements.
# Application dependencies remain locked; no model weights enter this image.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates ffmpeg libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/app && chmod 1777 /home/app
RUN uv python install 3.13
WORKDIR /opt/tft-apps/tft-chat
FROM native AS dependencies
COPY tft-chat/pyproject.toml tft-chat/uv.lock ./
RUN uv sync --locked --python 3.13 --extra evals --extra compositions --extra transcription --no-install-project --no-dev
FROM native
# Copy installed dependencies without shipping the package download cache.
COPY --from=dependencies /opt/venv /opt/venv
COPY tft-chat/ ./
COPY tft-chat/chat_tft.ini.example ./chat_tft.ini
COPY docker/backend.py /opt/tft-apps/docker/backend.py
COPY desktop/utils.py /opt/tft-apps/desktop/utils.py
COPY --from=frontend /build/dist ./app/frontend/dist
EXPOSE 8300
ENV XDG_STATE_HOME=/home/app/state
ENTRYPOINT []
CMD ["python", "/opt/tft-apps/docker/backend.py", "--service", "chat"]
