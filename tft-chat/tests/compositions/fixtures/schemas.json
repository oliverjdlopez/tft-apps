          }
        },
        "required": [
          "unit",
          "min_copies",
          "itemized"
        ],
        "title": "UnitRequirement",
        "type": "object"
      },
      "VariationDefinition": {
        "additionalProperties": false,
        "description": "Describe an optional recurrent structure within one family.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "patterns": {
