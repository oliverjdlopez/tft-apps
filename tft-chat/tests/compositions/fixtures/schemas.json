{
  "CompositionDetailResponse": {
    "$defs": {
      "BoardAssignment": {
        "additionalProperties": false,
        "description": "Record classification, competing candidates, and rejection reasons.",
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/$defs/FamilyCandidate"
            },
            "title": "Candidates",
            "type": "array"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "family_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Family Id"
          },
          "observation_id": {
            "minLength": 1,
            "title": "Observation Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "assigned",
              "ambiguous",
              "unclassified"
            ],
            "title": "Status",
            "type": "string"
          },
          "variation_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Variation Id"
          }
        },
        "required": [
          "observation_id",
          "status",
          "family_id",
          "variation_id",
          "candidates",
          "explanation"
