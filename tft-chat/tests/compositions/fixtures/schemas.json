        "required": [
          "observation_id",
          "level",
          "units",
          "traits"
        ],
        "title": "BoardObservation",
        "type": "object"
      },
      "BoardOutcome": {
        "additionalProperties": false,
        "description": "Hold outcomes separately until classification has finished.",
        "properties": {
          "observation_id": {
            "minLength": 1,
            "title": "Observation Id",
            "type": "string"
          },
          "placement": {
            "anyOf": [
