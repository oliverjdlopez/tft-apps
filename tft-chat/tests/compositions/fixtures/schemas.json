            "title": "Patterns",
            "type": "array"
          },
          "representative_observation_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Representative Observation Ids",
            "type": "array"
          },
          "variation_id": {
            "minLength": 1,
            "title": "Variation Id",
            "type": "string"
          }
        },
        "required": [
          "variation_id",
          "label",
          "description",
          "patterns",
          "representative_observation_ids"
