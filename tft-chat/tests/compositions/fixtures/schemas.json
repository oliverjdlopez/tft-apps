        "title": "VariationDefinition",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Version the complete family display wire contract.",
    "properties": {
      "context": {
        "$ref": "#/$defs/CompositionContext"
      },
      "examples": {
