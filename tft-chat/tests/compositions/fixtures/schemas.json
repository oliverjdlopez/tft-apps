        "title": "BoardAssignment",
        "type": "object"
      },
      "BoardExampleView": {
        "additionalProperties": false,
        "description": "Combine already-classified boards with separately computed display outcomes.",
        "properties": {
          "assignment": {
            "anyOf": [
              {
                "$ref": "#/$defs/BoardAssignment"
              },
              {
                "type": "null"
              }
