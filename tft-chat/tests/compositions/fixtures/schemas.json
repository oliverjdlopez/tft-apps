        "type": "array"
      },
      "family": {
        "$ref": "#/$defs/FamilyDefinition"
      },
      "profile": {
        "anyOf": [
          {
            "$ref": "#/$defs/FamilyProfile"
          },
          {
            "type": "null"
          }
        ]
      },
      "schema_version": {
        "const": "composition.v1",
        "title": "Schema Version",
        "type": "string"
      },
      "warnings": {
        "items": {
          "$ref": "#/$defs/CompositionWarning"
        },
        "title": "Warnings",
        "type": "array"
      }
    },
    "required": [
      "schema_version",
      "context",
      "family",
      "profile",
      "examples",
      "warnings"
    ],
