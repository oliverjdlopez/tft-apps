LANGFUSE_INIT_USER_PASSWORD=GENERATED
LANGFUSE_PUBLIC_KEY=pk-lf-GENERATED
LANGFUSE_SECRET_KEY=sk-lf-GENERATED
LANGFUSE_EXPERIMENT_TOKEN=GENERATED
POSTGRES_PASSWORD=GENERATED
CLICKHOUSE_PASSWORD=GENERATED
REDIS_AUTH=GENERATED
MINIO_ROOT_PASSWORD=GENERATED
SALT=GENERATED
NEXTAUTH_SECRET=GENERATED
ENCRYPTION_KEY=GENERATED_64_HEX_CHARACTERS
HOST_UID=1000
HOST_GID=1000
