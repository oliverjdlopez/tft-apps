# Private API keys — get from:
# Riot: https://developer.riotgames.com/
# Anthropic: https://console.anthropic.com/
# OpenAI: https://platform.openai.com/

RIOT_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Maximum concurrent assistant, judge, and selector model calls made by one
# eval run. Defaults to 8 when omitted and must be a positive integer.
# MAX_EVAL_CONCURRENCY=8
# EVAL_OPERATION_TIMEOUT_SECONDS=180
# EVAL_JUDGE_TIMEOUT_SECONDS=45
# EVAL_JUDGE_MODEL=
# PROMPTFOO_PYTHON=/absolute/path/to/project/.venv/bin/python

# Optional token used when the MCP server requires authentication.
# CHAT_TFT_MCP_TOKEN=

# Application RDS target. Omit RDS_PASSWORD to use IAM authentication; set it
# for password authentication. RDS_INSTANCE_ID is used by maintenance tools
# that resize or publish the configured instance.
RDS_INSTANCE_ID=chat_tft_dev1
RDS_HOST=your-rds-endpoint.amazonaws.com
RDS_PORT=5432
RDS_ADMIN=your_rds_master_username
RDS_DB=your_target_db_name
RDS_PASSWORD=
# Optional automatic local-IP ingress synchronization for the RDS security group.
RDS_SYNC_LOCAL_IP=true
# RDS_SECURITY_GROUP_ID=
# RDS_SECURITY_GROUP_RULE_DESCRIPTION=chat_tft_rds_local_ip
# RDS_IP_CACHE_FILE=~/.cache/chat_tft_rds_ip.txt
# RDS_IP_CHECK_URL=https://checkip.amazonaws.com

# Used only by tft-freeze-patch-db when creating a new RDS instance.
# RDS_MASTER_USER_PASSWORD=

# Optional RDS overrides for live evals. Missing values use the normal RDS_* value.
# RDS_EVAL_HOST=your-eval-rds-endpoint.amazonaws.com
# RDS_EVAL_PORT=5432
# RDS_EVAL_ADMIN=your_eval_rds_username
# RDS_EVAL_DB=your_eval_database
# RDS_EVAL_PASSWORD=
# RDS_EVAL_INSTANCE_ID=
# RDS_EVAL_SYNC_LOCAL_IP=true
# RDS_EVAL_SECURITY_GROUP_ID=
# RDS_EVAL_SECURITY_GROUP_RULE_DESCRIPTION=chat_tft_rds_local_ip
# RDS_EVAL_IP_CACHE_FILE=~/.cache/chat_tft_rds_eval_ip.txt
# RDS_EVAL_IP_CHECK_URL=https://checkip.amazonaws.com

# Optional isolated RDS target for tests. RDS_TEST_DB must end in _test.
# RDS_TEST_HOST=your-test-rds-endpoint.amazonaws.com
# RDS_TEST_PORT=5432
# RDS_TEST_ADMIN=your_test_rds_username
# RDS_TEST_DB=your_target_db_test
# RDS_TEST_PASSWORD=
# RDS_TEST_INSTANCE_ID=
# RDS_TEST_SYNC_LOCAL_IP=true
# RDS_TEST_SECURITY_GROUP_ID=
# RDS_TEST_SECURITY_GROUP_RULE_DESCRIPTION=chat_tft_rds_local_ip
# RDS_TEST_IP_CACHE_FILE=~/.cache/chat_tft_rds_test_ip.txt
# RDS_TEST_IP_CHECK_URL=https://checkip.amazonaws.com

# AWS credentials/region are resolved by boto3's default provider chain. Set
# these, use AWS_PROFILE, or use a shared credentials file/role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# S3 raw-payload mirror (opt-in): upload each ingested match payload to S3.
CHAT_TFT_S3_UPLOAD=false
# CHAT_TFT_S3_BUCKET=your-tft-match-bucket
# CHAT_TFT_S3_PREFIX=

# Optional Langfuse development export; also enable [chat] langfuse_tracing.
# Reuse your local project keys without committing them.
# LANGFUSE_BASE_URL=http://localhost:15510
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
